{
  "name": "xingxiaozhi-english-corner",
  "version": "0.1.0",
  "description": "行小之英语角：本地优先的英语查词、识图、自动背词与词汇冒险。",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:ocr-assets": "node scripts/sync-ocr-assets.mjs",
    "predev": "npm run sync:ocr-assets",
    "dev": "vinext dev",
    "prebuild": "npm run sync:ocr-assets",
    "build": "vinext build",
    "build:pages": "npm run sync:ocr-assets && next build",
    "verify:pages": "node scripts/verify-pages.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/tesseract"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "type": "module"
}
